# LinkUp Frontend Environment Variables
# Copy this file to .env and fill in your values

# App metadata
EXPO_PUBLIC_APP_OWNER=DHANIKA J
EXPO_PUBLIC_APP_VERSION=1.0

# Backend API base URL (no trailing slash)
# Used for all REST API calls (UserController, ProfileController, MediaController, etc.)
# Example: https://217b7332d13d.ngrok-free.app
EXPO_PUBLIC_APP_URL=https://your-ngrok-or-backend-url.com

# (Optional) Full API base URL if different from APP_URL + /LinkUp
# Example: https://your-backend.com/api
EXPO_PUBLIC_API_BASE_URL=

# WebSocket configuration
# Option A: Provide just the host (wss:// will be prepended)
# Example: 217b7332d13d.ngrok-free.app
EXPO_PUBLIC_WS_URL=your-ngrok-or-backend-url.com

# Option B: Provide the full WebSocket URL (overrides WS_URL construction)
# Example: wss://217b7332d13d.ngrok-free.app/LinkUp
EXPO_PUBLIC_WS_FULL_URL=